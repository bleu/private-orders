# Private trades — every environment variable this repository reads.
#
#   cp .env.example .env        # .env is git-ignored
#   set -a; . ./.env; set +a
#
# Sections marked "offline stack" are only for the local e2e runs. Everything under "chain" and
# "service" is what a real deployment needs.

# --- chain: same addresses on every chain CoW supports (mainnet, Sepolia, Gnosis, Arbitrum, Base…)

SETTLEMENT_CONTRACT_ADDRESS=0x9008D19f58AAbD9eD0D60971565AA8510560ab41
VAULT_RELAYER_ADDRESS=0xC92E8bdf79f0507f65a392b0ab4667716BFE0110
COMPOSABLE_COW_ADDRESS=0xfdaFc9d1902f4e0b84f65F49f244b32b31013b74
COWSHED_COMPOSABLE_COW_FACTORY_ADDRESS=0x5E284e80F3bd6A7D80A8500D9c49878028110848

RPC=https://sepolia.infura.io/v3/REPLACE_ME
ORDERBOOK_URL=https://api.cow.fi/sepolia

# Tokens. Mainnet values below are the ones the fork tests use. Sepolia has no USDC/DAI with the
# same addresses: set the pair you actually hold before a Sepolia rehearsal.
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
DAI_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F
DEFAULT_SELL_TOKEN=
DEFAULT_BUY_TOKEN=

# --- deploy

# The deployer's key. It pays gas and nothing else: `forge script` creates `new{salt}` through the
# canonical CREATE2 proxy, so the addresses do not depend on this key. DEPLOYER_ADDRESS is checked
# against it only to catch the wrong key being loaded before a broadcast.
DEPLOYER_PRIVATE_KEY=0xREPLACE_ME
DEPLOYER_ADDRESS=0xREPLACE_ME

# Fixed per release. Change it and every address moves, which needs a new allowlist entry.
# DEPLOY_SALT=0x...
# Where per-chain manifests are written (docs/DEPLOY.md copies them into deployments/).
# DEPLOY_MANIFEST=out-json/deployments

# --- service (link service + sub-solver)

PUBLIC_URL=http://localhost:9200
PORT=9200
PRIVATE_TRADE_ROOT=
SUBSOLVER_OFFERS_DIR=

# Written by the deploy script; set them explicitly only when overriding its output.
PRIVATE_TRADE_WRAPPER=
PRIVATE_TRADE_HANDLER=
PRIVATE_TRADE_AUTHORISER=

# Pays gas for relaying owner-signed bundles and submitting a settled pair. It needs no role beyond
# being able to send a transaction, and the submitter contract holds no key at all.
RELAYER_PRIVATE_KEY=0xREPLACE_ME

# --- the app's own smoke run (scripts/wallet-e2e.sh, scripts/app-e2e.sh)

PRIVATE_TRADE_USDC_AMOUNT=100000000
PRIVATE_TRADE_DAI_AMOUNT=100000000000000000000
PRIVATE_TRADE_VALID_FOR=86400
MAKER_PRIVATE_KEY=0xREPLACE_ME
TAKER_PRIVATE_KEY=0xREPLACE_ME

# --- offline stack only (scripts/offline-e2e.sh and the fork suite)

# FORK_RPC=https://ethereum-rpc.publicnode.com
# OFFLINE_DIR=
# SERVICE_URL=http://localhost:9200
# ANVIL_KEY_0=
# CHROME_PATH=
# CHROME_NO_SANDBOX=
# APP_E2E_MAKER=
# APP_E2E_TAKER=
# FIXTURE_CHAIN_ID=
# FIXTURE_PERMIT_KIND=

# Development keys for the local stack. Never set this against a real chain.
# PRIVATE_TRADE_DEV_KEYS=
